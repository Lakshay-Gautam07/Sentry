# Sentry Backend Environment Variables

# Server Port (Render sets this automatically; set 5000 for local dev)
PORT=5000

# YouTube Data API v3 (Required for destination videos)
YOUTUBE_API_KEY=

# Google Gemini API (Required for AI travel summaries)
GEMINI_API_KEY=

# MongoDB Atlas URI (Required for persistent destination caching)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/sentry?retryWrites=true&w=majority
MONGODB_URI=

# Allowed Frontend Origins for CORS (comma-separated if multiple, wildcards supported, or * for all)
# Example for production: https://sentry-1msyreljc-lakshay-s-projects9.vercel.app,http://localhost:5173
CLIENT_URL=https://sentry-1msyreljc-lakshay-s-projects9.vercel.app
